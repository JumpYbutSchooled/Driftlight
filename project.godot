; Engine configuration file.

config_version=5

[application]

config/name="Driftlight"
config/description="Starscape-inspired 3D space miner."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/output_latency=12
buses/channel_disable_time=1.0

[autoload]

Game="*res://scripts/game.gd"
Pix="*res://scripts/pix.gd"
Sfx="*res://scripts/sfx.gd"
Models="*res://scripts/models.gd"

[display]

window/size/viewport_width=1920
window/size/mode=3
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_size=8192
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssil/half_size=false
environment/glow/use_high_quality=true
environment/glow/upscale_mode=1
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.012, 0.024, 0.05, 1)
